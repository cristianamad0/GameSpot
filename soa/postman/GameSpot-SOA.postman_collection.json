              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('reservaId', pm.response.json().id);",
                  "pm.test('Adelanto del 50 %', function () { pm.expect(pm.response.json().adelantoPesos).to.eql(3000); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mañana en Bogotá, a las 3:00 p. m. (20:00 UTC): dentro del horario de cualquier día.",
                  "const manana = new Date(Date.now() + 24 * 60 * 60 * 1000).toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });",
                  "pm.collectionVariables.set('fecha', manana);",
                  "pm.collectionVariables.set('inicio', manana + 'T20:00:00Z');"
                ]
              }
            }
          ]
        },
