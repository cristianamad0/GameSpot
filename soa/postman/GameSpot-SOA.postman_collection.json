                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{reservas}}/api/auth/login",
              "host": [
                "{{reservas}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"laura@gamespot.demo\",\n  \"password\": \"ClienteDemo123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token', 'Bearer ' + pm.response.json().token);",
                  "pm.test('Rol CLIENTE', function () { pm.expect(pm.response.json().rol).to.eql('CLIENTE'); });"
                ]
